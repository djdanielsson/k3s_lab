# Custom Omnigent host image: official host image + the opencode CLI baked in.
#
# Why a fork of any kind: the `opencode-native` harness ships NO CLI in the
# official `omnigent-host` image (claude / codex / pi / kiro-cli / agy only), so
# every session that resolves to opencode-native can never launch in a managed
# sandbox. The upstream Dockerfile exposes exactly one supported extension point
# for this — the EXTRA_HARNESS_CLIS build arg, which runs
# deploy/docker/install-harness-cli.sh — and that is what this image uses. There
# is no source fork here: the whole build is `FROM <official host>` plus one
# script invocation, so the image tracks upstream except for the added CLI.
#
# Build context: this directory. No repo checkout required, and no git
# credential — everything comes either from the pinned base image or from the
# script fetched from the upstream tag below.
#
#   docker build -t omnigent-host-opencode:latest \
#     -f Dockerfile.omnigent-host-opencode .
#
# The base tag and the script ref are ARGs so a version bump is one --build-arg.
#
# PINNED, not `:latest`. Renovate's Dependency Dashboard shows this Dockerfile
# with NO detected dependency while the base is a mutable tag — there is no
# version to compare against, so an available upgrade is simply invisible. The
# pin below is the version already running (verified: ghcr's `latest` and
# `v0.19.0` shared the index digest sha256:eb0ab8dc… at the time of pinning), so
# pinning changes nothing in the image and everything for the update feed.
ARG HOST_BASE_IMAGE=ghcr.io/omnigent-ai/omnigent-host:v0.19.0
FROM ${HOST_BASE_IMAGE}

# Pin the script to the same upstream tag as the base image when you pin the
# base; `main` tracks the same code the official image is built from.
ARG INSTALL_SCRIPT_REF=main
ARG OPENCODE_VERSION=1.18.0

USER root
RUN set -eu; \
    curl -fsSL -o /tmp/install-harness-cli.sh \
      "https://raw.githubusercontent.com/omnigent-ai/omnigent/${INSTALL_SCRIPT_REF}/deploy/docker/install-harness-cli.sh"; \
    bash /tmp/install-harness-cli.sh "opencode@${OPENCODE_VERSION}"; \
    rm -f /tmp/install-harness-cli.sh

# The script's own smoke check runs as root and as the non-root `sandbox` user
# (uid 1000660000). Re-assert it, plus the version gate the runtime enforces
# (opencode_native.client: >=1.17.7,<1.19.0), so a bad base or a moved default
# fails the build instead of the first session.
RUN set -eu; \
    command -v opencode >/dev/null; \
    /usr/local/bin/opencode --version; \
    setpriv --reuid=sandbox --regid=sandbox --clear-groups \
      env HOME=/sandbox /usr/local/bin/opencode --version

# ---------------------------------------------------------------------------
# Cluster patch: make opencode-native launchable AND able to reach OpenCode Go
# directly. Two upstream gaps, both established by reading this image's code:
#
#   1. The runner's tunnel hello frame (`runner/transports/ws_tunnel/serve.py`)
#      lists the harness kinds it can spawn, and `opencode-native` is absent —
#      so the server never offers the harness on a managed sandbox even though
#      the CLI and the executor are installed. `configured_harness_map()` in the
#      same image already reports opencode-native: True (it is gated on the
#      binary), so the hello-frame row is the only missing piece.
#
#   2. `build_opencode_provider_config` writes an @ai-sdk/openai-compatible
#      provider with baseURL/apiKey only. OpenCode Go rejects requests without a
#      stable per-conversation `x-opencode-session` (400 MissingSessionID) and
#      asks for a real client identity, so a direct provider block can never
#      work unpatched. LiteLLM papers over this today by sending a constant
#      header; these headers are per Omnigent session instead, which is also
#      better for Go's prompt-cache affinity.
#
# This is a source edit inside the image's normal (non-editable) install. The
# patch is a real file in the build context, NOT a Dockerfile heredoc: Kaniko
# 1.23.2 hands `RUN python - <<'PY'` an empty stdin, so Python exits 0 without
# executing anything and the build goes green over an unpatched image. The
# script asserts both anchors and exits non-zero when a patch is missing.
COPY patches/opencode-direct.py /tmp/opencode-direct.py
RUN /opt/venv/bin/python /tmp/opencode-direct.py && rm -f /tmp/opencode-direct.py

# Everything below is `omnigent` PATH/filesystem-policy dependant, unchanged
# from the base image: the host runs as uid 1000660000 with HOME=/home/omnigent
# (see omnigent/onboarding/sandboxes/kubernetes.py). Nothing extra to install —
# opencode is a static Node bundle on the shared /usr/local/bin.
USER sandbox
WORKDIR /home/omnigent
